            <column caption='Tiempo estadia' datatype='integer' name='[Calculation_0118786133504001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;hour&apos;, [inicio], [fin])' />
            </column>
