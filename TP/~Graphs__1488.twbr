      <column caption='Orden Visita' datatype='integer' name='[Calculation_0102297670066179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Categoria' datatype='string' name='[Calculation_0102297673150470]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tipo_lugar] = &quot;HOME&quot; THEN &quot;Casa&quot;&#13;&#10;ELSEIF STARTSWITH(LOWER([tipo_lugar]), &quot;trabajo&quot;) THEN &quot;Trabajo&quot;&#13;&#10;ELSEIF STARTSWITH(LOWER([tipo_lugar]), &quot;planta&quot;) THEN &quot;Trabajo&quot;&#13;&#10;ELSEIF STARTSWITH(LOWER([tipo_lugar]), &quot;UNKNOWN&quot;) THEN &quot;SinCategoria&quot;&#13;&#10;ELSEIF STARTSWITH(LOWER([tipo_lugar]), &quot;SEARCHED_ADDRESS&quot;) THEN &quot;SinCategoria&quot;&#13;&#10;ELSE &quot;Social / Otros&quot;&#13;&#10;END' />
      </column>
      <column caption='Salgo de' datatype='string' name='[Calculation_0102297673412615]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Casa&quot;' />
      </column>
      <column caption='Vuelvo a' datatype='string' name='[Calculation_0102297673457672]' role='dimension' type='nominal'>
