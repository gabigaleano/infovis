          <datasource-dependencies datasource='federated.0uhod2j0zdf1c710u35b30apmd2i'>
            <column-instance column='[place_id]' derivation='Count' name='[cnt:place_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[tipo_lugar]' derivation='None' name='[none:tipo_lugar:nk]' pivot='key' type='nominal' />
            <column caption='Place Id' datatype='string' name='[place_id]' role='dimension' type='nominal' />
            <column caption='Tipo Lugar' datatype='string' name='[tipo_lugar]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;casa santi&quot;' value='Casa santi' />
                <alias key='&quot;INFERRED_HOME&quot;' value='Casa' />
              </aliases>
            </column>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0uhod2j0zdf1c710u35b30apmd2i].[none:tipo_lugar:nk]'>
            <groupfilter count='15' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='COUNT([place_id])' function='order' user:ui-marker='order'>
                <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
                  <groupfilter function='member' level='[none:tipo_lugar:nk]' member='&quot;Aeroparque&quot;' />
                  <groupfilter function='member' level='[none:tipo_lugar:nk]' member='&quot;Alto Avellaneda&quot;' />
                  <groupfilter function='member' level='[none:tipo_lugar:nk]' member='&quot;Barberia&quot;' />
                  <groupfilter function='member' level='[none:tipo_lugar:nk]' member='&quot;Barberia nuevo&quot;' />
